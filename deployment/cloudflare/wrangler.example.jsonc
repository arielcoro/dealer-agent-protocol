{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replace-with-protocol-worker-name",
  "main": "static-site-worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "../../site/dist",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "PILOT_DB",
      "database_name": "replace-with-d1-database-name",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "notifications@replace-with-protocol-domain.example",
        "notifications@replace-with-gateway-domain.example"
      ]
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "replace-with-turnstile-site-key"
  },
  "durable_objects": {
    "bindings": [
      { "name": "LEAD_RATE_LIMIT", "class_name": "LeadRateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v-lead-rate-limit", "new_sqlite_classes": ["LeadRateLimiter"] }
  ],
  "routes": [
    {
      "pattern": "replace-with-protocol-domain.example",
      "custom_domain": true
    }
  ]
  // Secrets (wrangler secret put): TURNSTILE_SECRET.
  // The EMAIL send_email binding and TURNSTILE_SECRET are required; the worker fails closed without them.
}
