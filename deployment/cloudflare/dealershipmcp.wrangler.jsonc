{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealershipmcp",
  "main": "product-site-worker.mjs",
  "compatibility_date": "2026-09-02",
  "assets": {
    "binding": "ASSETS",
    "directory": "../../dealershipmcp-site/dist",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "PILOT_DB",
      "database_name": "dealer-agent-pilot",
      "database_id": "b76b6b11-4773-4c61-821c-b8527d0d1dae",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "dealershipmcp.com", "custom_domain": true },
    { "pattern": "www.dealershipmcp.com", "custom_domain": true }
  ]
}
