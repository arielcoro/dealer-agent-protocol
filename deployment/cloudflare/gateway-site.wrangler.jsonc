{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealer-agent-gateway-site",
  "main": "static-site-worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "../../gateway-site/dist",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "dealeragentgateway.com",
      "custom_domain": true
    }
  ]
}
