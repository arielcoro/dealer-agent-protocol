{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealeragentprotocol.com/incubator/retail-actions/schemas/quote.schema.json",
  "title": "Dealer Agent Protocol non-binding transaction previews",
  "$defs": {
    "buyerContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jurisdiction", "payment_mode"],
      "properties": {
        "jurisdiction": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/jurisdiction" },
        "payment_mode": { "type": "string", "enum": ["cash", "finance", "lease", "unknown"] },
        "eligibility_claims": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "../../../spec/v0.1/schemas/pricing.schema.json#/$defs/eligibilityCriterion" }
        },
        "trade_in_present": { "type": "boolean" }
      }
    },
    "quoteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "rooftop_id", "vehicle_id", "buyer_context", "idempotency_key"],
      "properties": {
        "organization_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "rooftop_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "vehicle_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "buyer_context": { "$ref": "#/$defs/buyerContext" },
        "requested_adjustment_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" }
        },
        "idempotency_key": { "$ref": "action-common.schema.json#/$defs/idempotencyKey" }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id", "organization_id", "rooftop_id", "vehicle_id", "status",
        "lines", "subtotal", "total_status", "pricing_policy_version",
        "legal_commitment", "expires_at",
        "uncertainty", "provenance", "freshness", "trace_id"
      ],
      "properties": {
        "quote_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "organization_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "rooftop_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "vehicle_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "status": { "type": "string", "enum": ["complete", "partial", "unavailable", "expired"] },
        "lines": { "type": "array", "items": { "$ref": "action-common.schema.json#/$defs/quoteLine" } },
        "subtotal": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/nonNegativeMoney" },
        "total_status": { "type": "string", "enum": ["out_the_door", "partial", "not_calculable"] },
        "total": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/nonNegativeMoney" },
        "pricing_policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "unknown_components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["tax", "title", "registration", "government_charge", "eligibility", "trade_value", "lender_terms", "other"] }
        },
        "legal_commitment": { "const": false },
        "expires_at": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/timestamp" },
        "uncertainty": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/uncertainty" },
        "provenance": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/provenance" },
        "freshness": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/freshness" },
        "trace_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/traceId" }
      },
      "allOf": [
        {
          "if": { "properties": { "total_status": { "const": "out_the_door" } }, "required": ["total_status"] },
          "then": { "required": ["total"] },
          "else": {
            "required": ["unknown_components"],
            "not": { "required": ["total"] }
          }
        }
      ]
    },
    "holdRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "rooftop_id", "vehicle_id", "requested_duration_seconds", "idempotency_key"],
      "properties": {
        "organization_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "rooftop_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "vehicle_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "requested_duration_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "idempotency_key": { "$ref": "action-common.schema.json#/$defs/idempotencyKey" }
      }
    },
    "releaseHoldRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "rooftop_id", "hold_id", "idempotency_key"],
      "properties": {
        "organization_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "rooftop_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "hold_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "idempotency_key": { "$ref": "action-common.schema.json#/$defs/idempotencyKey" }
      }
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hold_id", "organization_id", "rooftop_id", "vehicle_id", "status", "legal_commitment", "trace_id"],
      "properties": {
        "hold_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "organization_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "rooftop_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "vehicle_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "status": { "type": "string", "enum": ["active", "released", "expired", "rejected"] },
        "expires_at": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/timestamp" },
        "legal_commitment": { "const": false },
        "trace_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/traceId" }
      }
    },
    "appointmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "rooftop_id", "vehicle_id", "department", "requested_windows", "idempotency_key"],
      "properties": {
        "organization_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "rooftop_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "vehicle_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "department": { "type": "string", "enum": ["sales", "internet_sales"] },
        "requested_windows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["starts_at", "ends_at"],
            "properties": {
              "starts_at": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/timestamp" },
              "ends_at": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/timestamp" }
            }
          }
        },
        "idempotency_key": { "$ref": "action-common.schema.json#/$defs/idempotencyKey" }
      }
    },
    "cancelAppointmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "rooftop_id", "appointment_id", "idempotency_key"],
      "properties": {
        "organization_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "rooftop_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "appointment_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "idempotency_key": { "$ref": "action-common.schema.json#/$defs/idempotencyKey" }
      }
    },
    "appointment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appointment_id", "organization_id", "rooftop_id", "vehicle_id", "status", "legal_commitment", "trace_id"],
      "properties": {
        "appointment_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "organization_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "rooftop_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "vehicle_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/identifier" },
        "status": { "type": "string", "enum": ["requested", "confirmed", "cancelled", "rejected"] },
        "starts_at": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/timestamp" },
        "ends_at": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/timestamp" },
        "legal_commitment": { "const": false },
        "trace_id": { "$ref": "../../../spec/v0.1/schemas/common.schema.json#/$defs/traceId" }
      }
    }
  },
  "$ref": "#/$defs/quote"
}
